# Application
NODE_ENV=development
PORT=3000
APP_NAME=TradeNest
API_PREFIX=api/v1

# Database (PostgreSQL)
POSTGRES_USER=tradenest
POSTGRES_PASSWORD=tradenest
POSTGRES_DB=tradenest
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tradenest:tradenest@localhost:5433/tradenest?schema=public

# Redis (set REDIS_ENABLED=false for local dev without Docker/Redis)
REDIS_ENABLED=true
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Development only: set false to require Origin header (Postman must send Origin)
BETTER_AUTH_DISABLE_CSRF_CHECK=true

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# Cache
CACHE_TTL=30000
CACHE_MAX_ITEMS=1000

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tradenest-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TradeNest <noreply@tradenest.com>

# bKash tokenized checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_IS_LIVE=false

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com.bd

# SMS / OTP delivery
# console = log OTP to server console (local dev, no API key needed)
# bulksmsbd = BulkSMSBD HTTP API (https://bulksmsbd.net)
# http = generic POST JSON provider (set SMS_BASE_URL)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=TradeNest
SMS_BASE_URL=

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Swagger
SWAGGER_ENABLED=true
