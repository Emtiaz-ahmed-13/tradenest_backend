# Application
NODE_ENV=development
PORT=3000
APP_NAME=TradeNest
API_PREFIX=api/v1

# Database (PostgreSQL)
POSTGRES_USER=tradenest
POSTGRES_PASSWORD=tradenest
POSTGRES_DB=tradenest
POSTGRES_PORT=5433
DATABASE_URL=postgresql://tradenest:tradenest@localhost:5433/tradenest?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Development only: set false to require Origin header (Postman must send Origin)
BETTER_AUTH_DISABLE_CSRF_CHECK=true

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# Cache
CACHE_TTL=30000
CACHE_MAX_ITEMS=1000

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tradenest-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TradeNest <noreply@tradenest.com>

# Swagger
SWAGGER_ENABLED=true
